# Razorpay publishable key (Key ID) — safe to expose in the browser.
# The Key SECRET must never be placed here; it lives only in server/.env.
VITE_RAZORPAY_KEY_ID=

# API base URL. Leave unset in local dev so the Vite proxy
# (/api -> http://localhost:5001) is used. Set it in production, e.g.
# VITE_API_URL=https://api.example.com
VITE_API_URL=
