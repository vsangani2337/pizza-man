# --- Server ---
PORT=5001
NODE_ENV=development

# --- Database ---
# MongoDB connection string (local: mongodb://127.0.0.1:27017/pizzaDB)
MONGO_URI=mongodb://127.0.0.1:27017/pizzaDB

# --- Auth ---
# Use a long random string (32+ chars), e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=7d

# --- Admin bootstrap ---
# An admin account is created on first start only if both are set.
ADMIN_EMAIL=admin@pizza.com
ADMIN_PASSWORD=admin@1234
ADMIN_NAME=Admin

# --- Frontend ---
# Origin used for CORS and for links inside verification/reset emails.
CLIENT_URL=http://localhost:5173
# Optional: extra allowed origins, comma separated
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Set to 1/true when running behind a reverse proxy (needed for rate limiting)
TRUST_PROXY=0

# --- Email (Nodemailer) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
# Optional: force STARTTLS/SSL. Defaults to `true` for port 465, `false` otherwise.
# EMAIL_SECURE=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- Pricing / stock ---
# Charges are optional. Defaults are 0 => total equals the ingredient subtotal.
DELIVERY_FEE=0
# Delivery becomes free when the subtotal reaches this value (0 = never free)
FREE_DELIVERY_ABOVE=0
# Percentage, e.g. 5 for 5% GST
TAX_RATE_PERCENT=0
# Items below this stock level trigger the low-stock email
STOCK_THRESHOLD=20
# Optional size multiplier overrides, e.g. "small:0.9,medium:1,large:1.35"
# SIZE_MULTIPLIERS=small:0.85,medium:1,large:1.3
